# Server port (Render injects PORT automatically; local default is 3000)
PORT=3000
NODE_ENV=development

# Neon Postgres pooled connection string (SSL is enabled automatically for remote Postgres)
# Leave empty during local preview to use embedded PostgreSQL (PGlite in .data/pglite)
DATABASE_URL=

# Required in production: long random string for signing session cookies
SESSION_SECRET=

# First-run Admin credentials (created automatically on first startup when set)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional: Free YouTube Data API v3 key (app works completely without it via youtube-sr + oEmbed)
YOUTUBE_API_KEY=

# Optional operational limits
MAX_ROOMS=50
MAX_USERS_PER_ROOM=30
MAX_PLAYLIST_IMPORT=100
MAX_CHAT_MESSAGES=100
